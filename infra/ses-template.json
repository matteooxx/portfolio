    "HtmlPart": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>New Portfolio Contact</title></head><body style=\"margin:0;padding:0;background:#f5f7fa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2933;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:24px 0;\"><tr><td align=\"center\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;width:100%;background:#ffffff;border:1px solid #e4e7eb;border-radius:8px;overflow:hidden;\"><tr><td style=\"background:#2563eb;color:#ffffff;padding:20px 24px;\"><h1 style=\"margin:0;font-size:18px;font-weight:600;letter-spacing:-0.01em;\">New Contact Form Submission</h1></td></tr><tr><td style=\"padding:24px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:14px;line-height:1.6;\"><tr><td style=\"padding:6px 0;color:#52606d;width:110px;\">Name</td><td style=\"padding:6px 0;color:#1f2933;font-weight:500;\">{{name}}</td></tr><tr><td style=\"padding:6px 0;color:#52606d;\">Email</td><td style=\"padding:6px 0;color:#1f2933;font-weight:500;\"><a href=\"mailto:{{senderEmail}}\" style=\"color:#2563eb;text-decoration:none;\">{{senderEmail}}</a></td></tr><tr><td style=\"padding:6px 0;color:#52606d;\">Subject</td><td style=\"padding:6px 0;color:#1f2933;font-weight:500;\">{{subject}}</td></tr><tr><td style=\"padding:6px 0;color:#52606d;\">Timestamp</td><td style=\"padding:6px 0;color:#1f2933;font-weight:500;\">{{timestamp}}</td></tr></table><hr style=\"border:0;border-top:1px solid #e4e7eb;margin:20px 0;\"><div style=\"font-size:13px;color:#52606d;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:8px;\">Message</div><div style=\"font-size:14px;line-height:1.6;color:#1f2933;white-space:pre-wrap;\">{{message}}</div></td></tr><tr><td style=\"background:#f5f7fa;color:#52606d;padding:16px 24px;font-size:12px;text-align:center;border-top:1px solid #e4e7eb;\">This email was sent from your portfolio contact form.</td></tr></table></td></tr></table></body></html>"
  }
