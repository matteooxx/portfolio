{
  // Static pages are served straight from the assets directory below, which
  // Workers Builds fills by running `bash scripts/build-cloudflare-pages.sh`
  // (only the public allowlist and cloudflare/_headers). Never point it at the
  // repository root.
  //
  // Only /api/* runs worker/index.mjs first. POST /api/contact verifies a
  // Turnstile token and emails the message through CONTACT_EMAIL, a
  // send_email binding that can reach one verified destination address. The
  // Turnstile secret is the Worker secret TURNSTILE_SECRET_KEY; it is never
  // stored in this repository.
  "name": "matteo-mastore-portfolio",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist/cloudflare-pages",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://matteomastore.com",
    "TURNSTILE_HOSTNAMES": "matteomastore.com",
    "CONTACT_FROM": "contact@matteomastore.com",
    "CONTACT_TO": "matteo.mastore.job@gmail.com"
  },
  // Rate limiting for POST /api/contact, the only gate in front of the
  // send_email quota other than Turnstile. This binding needs nothing
  // provisioned in the dashboard: namespace_id is just a positive integer that
  // has to be unique inside this account, so a plain `git push` deploy still
  // needs zero manual setup. Keep 1001 reserved for the contact form if
  // another limiter is ever added - bindings that share a namespace_id share
  // counters. Needs Wrangler 4.36.0 or newer; "period" accepts only 10 or 60.
  // The worker fails open if the binding is missing, see withinRateLimit().
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "matteo.mastore.job@gmail.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
